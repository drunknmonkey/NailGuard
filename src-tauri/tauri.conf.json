{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tawel",
  "version": "0.1.11",
  "identifier": "app.tawel.alpha",
  "build": {
    "frontendDist": "../spike-dist",
    "beforeBuildCommand": "bash spike/build-frontend.sh",
    "beforeDevCommand": "bash spike/build-frontend.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Tawel",
        "width": 620,
        "height": 760,
        "resizable": true,
        "minimizable": true,
        "backgroundThrottling": "disabled",
        "transparent": false,
        "shadow": true,
        "minWidth": 460,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
